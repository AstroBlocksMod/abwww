# Copy to .env for local development. docker compose reads this file too.
# Every variable is documented in docs/self-hosting.md.

# Public URL of the site, no trailing slash. Required in production.
ORIGIN=http://localhost:5173
SITE_NAME=AstroBlocks

DATABASE_URL=postgres://abwww:abwww@localhost:5432/abwww
VALKEY_URL=redis://localhost:6379

# Assets and project git repositories. Back this up.
DATA_DIR=./data

# The editor's static build, served at /editor. See docs/editor.md.
EDITOR_DIR=./editor
# Where browsers load the editor from. In production give it its own origin, for example
# https://editor.example.com pointed at this same app.
# EDITOR_URL=http://localhost:5173/editor

# The Scratch project whose comments are checked for verification codes, and its owner.
# Without these, linking Scratch accounts is turned off.
# SCRATCH_VERIFY_PROJECT_ID=123456789
# SCRATCH_VERIFY_PROJECT_OWNER=yourScratchName
# Shown to Scratch in our User-Agent so they can reach the operator.
# SCRATCH_CONTACT=admin@example.com

# Limits, in bytes.
PROJECT_JSON_MAX_BYTES=20971520
ASSET_MAX_BYTES=26214400
SB3_MAX_BYTES=209715200

SESSION_TTL_DAYS=30
# open or closed
REGISTRATION=open
# true or false
FEDERATION=true

# Read by the Bun adapter: uploads go through the request body, so raise its default of 512K.
BODY_SIZE_LIMIT=256M
